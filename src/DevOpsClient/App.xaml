<Application x:Class="DevOpsClient.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" StartupUri="MainWindow.xaml">
 <Application.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
   <!-- Telerik NoXaml + implicit styles. These must precede Orbit's keyed shell styles. -->
   <ResourceDictionary Source="/Telerik.Windows.Themes.Fluent;component/Themes/System.Windows.xaml"/>
   <ResourceDictionary Source="/Telerik.Windows.Themes.Fluent;component/Themes/Telerik.Windows.Controls.xaml"/>
   <ResourceDictionary Source="/Telerik.Windows.Themes.Fluent;component/Themes/Telerik.Windows.Controls.Input.xaml"/>
   <ResourceDictionary Source="/Telerik.Windows.Themes.Fluent;component/Themes/Telerik.Windows.Controls.GridView.xaml"/>
   <ResourceDictionary Source="/Telerik.Windows.Themes.Fluent;component/Themes/Telerik.Windows.Controls.RichTextBox.xaml"/>
   <ResourceDictionary Source="WorkspaceResources.xaml"/>
  </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="Ink" Color="#EAF0F6"/><SolidColorBrush x:Key="Muted" Color="#93A1B3"/>
  <SolidColorBrush x:Key="Accent" Color="#77E0BC"/><SolidColorBrush x:Key="Line" Color="#293341"/>
  <SolidColorBrush x:Key="ShellBackground" Color="#10151D"/><SolidColorBrush x:Key="SidebarBackground" Color="#141B25"/><SolidColorBrush x:Key="Surface" Color="#151D27"/><SolidColorBrush x:Key="SurfaceRaised" Color="#19222E"/><SolidColorBrush x:Key="InputBackground" Color="#111923"/><SolidColorBrush x:Key="ButtonBackground" Color="#202B38"/><SolidColorBrush x:Key="Border" Color="#354253"/><SolidColorBrush x:Key="AccentText" Color="#10251F"/><SolidColorBrush x:Key="Selection" Color="#397B68"/><SolidColorBrush x:Key="NoticeBackground" Color="#303024"/><SolidColorBrush x:Key="NoticeForeground" Color="#E7CF98"/><SolidColorBrush x:Key="QueueTitle" Color="#EAF0F6"/><SolidColorBrush x:Key="QueueState" Color="#B0C3D5"/><SolidColorBrush x:Key="QueueMeta" Color="#9EB0C3"/><SolidColorBrush x:Key="QueueHover" Color="#1F2B38"/><SolidColorBrush x:Key="QueueSelected" Color="#25384B"/><SolidColorBrush x:Key="QueueFocus" Color="#77CBE0"/>
  <Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource ShellBackground}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <!-- Do not replace Telerik's implicit control templates. These keyed styles only add Orbit-specific chrome. -->
 <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0"/></Style>
 </ResourceDictionary></Application.Resources>
</Application>


